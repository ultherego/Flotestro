#!/bin/sh
set -e
case "$1" in
purge)
    # Purge deletes the fleet CA key. Without it no agent is recognised and
    # the whole fleet needs enrolling again, which is why on an ordinary
    # removal the state directory stays untouched.
    rm -rf /var/lib/flotestro
    rm -f /etc/flotestro/control-plane.env
    rmdir /etc/flotestro 2>/dev/null || true
    if getent passwd flotestro >/dev/null; then
        deluser --system flotestro >/dev/null 2>&1 || true
    fi
    ;;
esac
systemctl daemon-reload || true
