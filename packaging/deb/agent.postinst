#!/bin/sh
# Agent configuration after the package installation.
set -e

case "$1" in
configure)
    # A service account without a shell and without a home directory: the
    # agent is not an identity anybody logs into the host with.
    if ! getent passwd flotestro-agent >/dev/null; then
        adduser --system --group --no-create-home \
            --home /var/lib/flotestro-agent --shell /usr/sbin/nologin \
            flotestro-agent >/dev/null
    fi

    # Reading the journal without root requires membership in the
    # systemd-journal group. A missing group is not an installation error -
    # the journal read is then unavailable, and the agent reports that
    # instead of pretending the journal is empty.
    if getent group systemd-journal >/dev/null; then
        usermod --append --groups systemd-journal flotestro-agent
    fi

    install -d -m 0700 -o flotestro-agent -g flotestro-agent /var/lib/flotestro-agent
    install -d -m 0755 /etc/flotestro
    # The configuration is read by the agent itself, so it must be able to
    # open it - but nobody besides it and root may replace it: the right to
    # write here is the right to redirect the host to somebody else's panel.
    for file in /etc/flotestro/agent.yaml /etc/flotestro/agent.env; do
        if [ -f "$file" ]; then
            chown root:flotestro-agent "$file"
            chmod 0640 "$file"
        fi
    done

    systemctl daemon-reload || true
    # The helper socket must exist before the agent tries to connect to it.
    systemctl enable --now flotestro-helper.socket || true
    # The helper is started by the socket and keeps running after the binary
    # is replaced, so after an update it would serve jobs with the old code
    # until the idle timeout. Stopping it here makes the next job reach the
    # new version; the socket starts it again on demand.
    systemctl stop flotestro-helper.service || true

    # An agent without a panel address has nowhere to connect. Running it in
    # a restart loop would litter the host journal; the installation then
    # ends with a hint, not a quiet error.
    systemctl enable flotestro-agent.service || true
    if [ -e /var/lib/flotestro-agent/identity/current/agent.pem ] ||
       [ -e /var/lib/flotestro-agent/agent.pem ]; then
        # The host already has an identity: a package update is to resume it
        # - and really resume it. "start" on a running service does nothing,
        # so after an update the old process from the old binary would keep
        # working.
        systemctl start flotestro-agent.service || true
        systemctl try-restart flotestro-agent.service || true
    else
        # Enrollment is an operator decision and requires a token, so the
        # package does not guess it. The service has a start condition on
        # the identity, so until enrollment it simply does not come up -
        # instead of spinning in restarts.
        echo "flotestro-agent: fill in /etc/flotestro/agent.yaml and enroll the host" >&2
        echo "  sudo -u flotestro-agent flotestro-agentctl enroll" >&2
        echo "  systemctl start flotestro-agent.service" >&2
    fi
    ;;
esac
