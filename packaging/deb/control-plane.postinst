#!/bin/sh
# Control plane configuration after the package installation.
set -e

case "$1" in
configure)
    # The service account is made with the shadow tools from the passwd
    # package, the same ones the .rpm scriptlet uses; the adduser wrapper
    # would be a dependency for one line of a maintainer script.
    if ! getent passwd flotestro >/dev/null; then
        getent group flotestro >/dev/null || groupadd --system flotestro
        useradd --system --gid flotestro --no-create-home \
            --home-dir /var/lib/flotestro --shell /usr/sbin/nologin flotestro
    fi

    # The state directory holds the fleet CA key - the most sensitive
    # material in the system.
    install -d -m 0700 -o flotestro -g flotestro /var/lib/flotestro
    install -d -m 0755 /etc/flotestro
    if [ -f /etc/flotestro/control-plane.env ]; then
        chown root:flotestro /etc/flotestro/control-plane.env
        chmod 0640 /etc/flotestro/control-plane.env
    fi

    systemctl daemon-reload || true

    # A panel without a database has nowhere to keep the fleet state.
    # Running it in a restart loop would litter the journal; the
    # installation then ends with a hint.
    if grep -qs '^FLOTESTRO_DATABASE_URL=.*change-me' /etc/flotestro/control-plane.env; then
        systemctl enable flotestro-control-plane.service || true
        echo "flotestro-control-plane: set FLOTESTRO_DATABASE_URL in" >&2
        echo "  /etc/flotestro/control-plane.env and run" >&2
        echo "  systemctl start flotestro-control-plane.service" >&2
    else
        systemctl enable --now flotestro-control-plane.service || true
    fi
    ;;
esac
