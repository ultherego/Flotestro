#!/bin/sh
set -e
case "$1" in
purge)
    # Tozsamosc relaya zostaje przy zwyklym usunieciu: ponowna instalacja ma
    # ja odzyskac bez enrollmentu. Purge kasuje ja swiadomie - relay bedzie
    # wtedy dla centrali nowym wezlem.
    rm -rf /var/lib/flotestro-relay
    rmdir /etc/flotestro 2>/dev/null || true
    if getent passwd flotestro-relay >/dev/null; then
        deluser --system flotestro-relay >/dev/null 2>&1 || true
    fi
    ;;
esac
systemctl daemon-reload || true
