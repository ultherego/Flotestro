#!/bin/sh
set -e
case "$1" in
purge)
    # The relay identity stays on an ordinary removal: a reinstall is to
    # recover it without enrollment. Purge deletes it deliberately - the
    # relay is then a new node to the centre.
    rm -rf /var/lib/flotestro-relay
    rmdir /etc/flotestro 2>/dev/null || true
    if getent passwd flotestro-relay >/dev/null; then
        deluser --system flotestro-relay >/dev/null 2>&1 || true
    fi
    ;;
esac
systemctl daemon-reload || true
