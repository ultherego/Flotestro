#!/bin/sh
set -e
case "$1" in
purge)
    # The agent identity and the private key stay on an ordinary removal: a
    # reinstall is to recover the same identity without enrollment. Purge
    # deletes them deliberately - the host is then a new machine to the
    # panel.
    rm -rf /var/lib/flotestro-agent
    rm -f /etc/flotestro/agent.env
    rmdir /etc/flotestro 2>/dev/null || true
    if getent passwd flotestro-agent >/dev/null; then
        deluser --system flotestro-agent >/dev/null 2>&1 || true
    fi
    ;;
esac
systemctl daemon-reload || true
