# The agent package for Arch and its derivatives (CachyOS, EndeavourOS).
#
# The PKGBUILD compiles no code: it takes the binaries that already passed
# the tests, exactly like the .deb and .rpm packages. Thanks to that all
# three families get the same artefact, not three different build results.
#
# The checksums are explicit and computed when the release is composed:
# "SKIP" would mean a package whose content nobody checked.
pkgname=flotestro-agent
pkgver=__VERSION__
pkgrel=1
pkgdesc='Flotestro fleet agent'
arch=('x86_64' 'aarch64')
url='https://github.com/ultherego/flotestro'
license=('Apache-2.0')
# The whole of what the agent needs at run time: the units and the journal,
# the trust store for the session to the control plane, and the shadow tools
# the local account module mutates accounts with. Every other module drives a
# tool the host already has; a tool that is not there disables exactly one
# capability, which the agent reports as unavailable by name.
depends=('systemd' 'ca-certificates' 'shadow')
# checkupdates is a faster way to the same upgrade plan, not a requirement:
# without pacman-contrib the plan is computed from the private copy of the
# sync database the helper keeps, with the system database untouched.
optdepends=('pacman-contrib: faster upgrade plan through checkupdates')
# The host configuration survives package updates; the new version lands
# next to it as .pacnew and must be visible in diagnostics.
backup=('etc/flotestro/agent.yaml')
# The package carries ready binaries, so there is nothing to compose a debug
# package from: makepkg would make an empty one, and its name is so similar
# that it is easy to release instead of the right one.
options=('!debug')
install=flotestro-agent.install
source=(
  "flotestro-agent"
  "flotestro-agentctl"
  "flotestro-agent-helper"
  'flotestro-agent.service'
  'flotestro-enroll.service'
  'flotestro-helper.service'
  'flotestro-helper.socket'
  'flotestro-firewall-restore.service'
  'flotestro-agent.sysusers'
  'flotestro-agent.tmpfiles'
  'agent.yaml'
  'helper.yaml'
  __SBOM__
)
sha256sums=(__SUMS__)

package() {
  install -Dm644 helper.yaml "$pkgdir/usr/share/flotestro/helper.yaml"
  install -Dm755 flotestro-agent        "$pkgdir/usr/bin/flotestro-agent"
  install -Dm755 flotestro-agentctl     "$pkgdir/usr/bin/flotestro-agentctl"
  install -Dm755 flotestro-agent-helper "$pkgdir/usr/bin/flotestro-agent-helper"

  install -Dm644 flotestro-agent.service   "$pkgdir/usr/lib/systemd/system/flotestro-agent.service"
  install -Dm644 flotestro-enroll.service  "$pkgdir/usr/lib/systemd/system/flotestro-enroll.service"
  install -Dm644 flotestro-helper.service  "$pkgdir/usr/lib/systemd/system/flotestro-helper.service"
  install -Dm644 flotestro-helper.socket   "$pkgdir/usr/lib/systemd/system/flotestro-helper.socket"
  install -Dm644 flotestro-firewall-restore.service \
    "$pkgdir/usr/lib/systemd/system/flotestro-firewall-restore.service"

  install -Dm644 flotestro-agent.sysusers  "$pkgdir/usr/lib/sysusers.d/flotestro-agent.conf"
  install -Dm644 flotestro-agent.tmpfiles  "$pkgdir/usr/lib/tmpfiles.d/flotestro-agent.conf"
  install -Dm640 agent.yaml                "$pkgdir/etc/flotestro/agent.yaml"

  # The bill of materials of every binary, written when the binaries were
  # built: the agent's own as sbom.cdx.json, the others under their names.
  if [ -f flotestro-agent.cdx.json ]; then
    install -Dm644 flotestro-agent.cdx.json "$pkgdir/usr/share/doc/flotestro-agent/sbom.cdx.json"
  fi
  local bill
  for bill in flotestro-agent-helper flotestro-agentctl; do
    if [ -f "$bill.cdx.json" ]; then
      install -Dm644 "$bill.cdx.json" "$pkgdir/usr/share/doc/flotestro-agent/sbom-$bill.cdx.json"
    fi
  done
}
