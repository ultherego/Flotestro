# The relay package for Arch and its derivatives (CachyOS, EndeavourOS).
#
# The PKGBUILD compiles no code: it takes the binary that already passed the
# tests, exactly like the .deb and .rpm packages.
pkgname=flotestro-relay
pkgver=__VERSION__
pkgrel=1
pkgdesc='Flotestro site relay'
arch=('x86_64' 'aarch64')
url='https://github.com/ultherego/flotestro'
license=('Apache-2.0')
depends=('systemd' 'ca-certificates' 'shadow')
# The site configuration survives package updates; the new version lands
# next to it as .pacnew.
backup=('etc/flotestro/relay.yaml')
# The package carries ready binaries, so there is nothing to compose a debug
# package from: makepkg would make an empty one, and its name is so similar
# that it is easy to release instead of the right one.
options=('!debug')
install=flotestro-relay.install
source=(
  "flotestro-relay"
  "flotestro-relayctl"
  'flotestro-relay.service'
  'flotestro-relay.sysusers'
  'flotestro-relay.tmpfiles'
  'relay.yaml'
  __SBOM__
)
sha256sums=(__SUMS__)

package() {
  install -Dm755 flotestro-relay          "$pkgdir/usr/bin/flotestro-relay"
  install -Dm755 flotestro-relayctl       "$pkgdir/usr/bin/flotestro-relayctl"
  install -Dm644 flotestro-relay.service  "$pkgdir/usr/lib/systemd/system/flotestro-relay.service"
  install -Dm644 flotestro-relay.sysusers "$pkgdir/usr/lib/sysusers.d/flotestro-relay.conf"
  install -Dm644 flotestro-relay.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/flotestro-relay.conf"
  install -Dm640 relay.yaml               "$pkgdir/etc/flotestro/relay.yaml"

  # The bill of materials of every binary, written when the binaries were
  # built: the relay's own as sbom.cdx.json, the others under their names.
  if [ -f flotestro-relay.cdx.json ]; then
    install -Dm644 flotestro-relay.cdx.json "$pkgdir/usr/share/doc/flotestro-relay/sbom.cdx.json"
  fi
  if [ -f flotestro-relayctl.cdx.json ]; then
    install -Dm644 flotestro-relayctl.cdx.json "$pkgdir/usr/share/doc/flotestro-relay/sbom-flotestro-relayctl.cdx.json"
  fi
}
