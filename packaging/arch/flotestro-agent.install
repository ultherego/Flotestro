# The package scriptlets. Only what concerns the system itself is allowed
# here: the service account, the directories and the units. Enrollment is an
# operator decision and must not be a side effect of installing the package,
# so the package neither fetches a token nor talks to the panel.
# The Arch package ships no environment file, but a host may carry one from
# an earlier installation. The daemon no longer enrolls, so a token left in
# it is a secret lying in a file for nothing; the package says so and
# touches nothing.
warn_about_lingering_token() {
    if [ -f /etc/flotestro/agent.env ] &&
       grep -Eq '^[[:space:]]*FLOTESTRO_ENROLLMENT_TOKEN=[[:space:]]*[^[:space:]#]' /etc/flotestro/agent.env; then
        cat >&2 <<'END'
flotestro-agent: /etc/flotestro/agent.env still carries FLOTESTRO_ENROLLMENT_TOKEN
  the daemon ignores it; enrollment is done with: sudo -u flotestro-agent flotestro-agentctl enroll
  remove the line from the file
END
    fi
}

post_install() {
    warn_about_lingering_token
    systemd-sysusers /usr/lib/sysusers.d/flotestro-agent.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/flotestro-agent.conf >/dev/null 2>&1 || true
    chown root:flotestro-agent /etc/flotestro/agent.yaml 2>/dev/null || true
    chmod 0640 /etc/flotestro/agent.yaml 2>/dev/null || true
    # The helper's settings, on a first installation only. post_upgrade does not
    # do this: switching a running fleet to enforce is the operator's decision.
    if [ ! -f /etc/flotestro/helper.yaml ] && [ -f /usr/share/flotestro/helper.yaml ]; then
        install -m 0644 -o root -g root /usr/share/flotestro/helper.yaml \
            /etc/flotestro/helper.yaml
        echo "flotestro-agent: /etc/flotestro/helper.yaml was written with capabilities.mode: enforce" >&2
    fi
    # The helper socket must exist before the agent tries to connect to it.
    systemctl enable --now flotestro-helper.socket >/dev/null 2>&1 || true
    # The panel's own nftables table is in no boot file of the distribution,
    # so a unit of ours rebuilds it from the helper's registry before the host
    # is reachable. It is started and not restarted: where it has already run
    # the table is in place, and rebuilding it would flush and refill it.
    systemctl enable flotestro-firewall-restore.service >/dev/null 2>&1 || true
    systemctl start flotestro-firewall-restore.service >/dev/null 2>&1 || true
    systemctl enable flotestro-agent.service >/dev/null 2>&1 || true
    cat >&2 <<'END'
flotestro-agent: fill in /etc/flotestro/agent.yaml and enroll the host
  sudo -u flotestro-agent flotestro-agentctl enroll
  systemctl start flotestro-agent.service
END
}

post_upgrade() {
    warn_about_lingering_token
    systemd-sysusers /usr/lib/sysusers.d/flotestro-agent.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/flotestro-agent.conf >/dev/null 2>&1 || true
    chown root:flotestro-agent /etc/flotestro/agent.yaml 2>/dev/null || true
    chmod 0640 /etc/flotestro/agent.yaml 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    # The helper keeps running after the binary is replaced, so after an
    # update it would serve jobs with the old code; the socket starts the
    # new version.
    systemctl stop flotestro-helper.service >/dev/null 2>&1 || true
    systemctl enable flotestro-firewall-restore.service >/dev/null 2>&1 || true
    systemctl start flotestro-firewall-restore.service >/dev/null 2>&1 || true
    systemctl try-restart flotestro-agent.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl disable --now flotestro-agent.service >/dev/null 2>&1 || true
    systemctl disable --now flotestro-helper.socket >/dev/null 2>&1 || true
    systemctl disable flotestro-firewall-restore.service >/dev/null 2>&1 || true
}

post_remove() {
    # The host identity stays: a reinstall is to recover it without
    # enrollment. Only retiring the host from the fleet deletes it.
    systemctl daemon-reload >/dev/null 2>&1 || true
}
