# Skryptlety pakietu relaya. Wolno tu tylko to, co dotyczy samego systemu.
# Enrollment jest decyzja operatora i nie moze byc skutkiem ubocznym
# instalacji pakietu.
post_install() {
    systemd-sysusers /usr/lib/sysusers.d/flotestro-relay.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/flotestro-relay.conf >/dev/null 2>&1 || true
    chown root:flotestro-relay /etc/flotestro/relay.yaml 2>/dev/null || true
    chmod 0640 /etc/flotestro/relay.yaml 2>/dev/null || true
    systemctl enable flotestro-relay.service >/dev/null 2>&1 || true
    cat >&2 <<'KONIEC'
flotestro-relay: uzupelnij /etc/flotestro/relay.yaml i zarejestruj relay
  sudo -u flotestro-relay flotestro-relay enroll -token-file <plik>
  systemctl start flotestro-relay.service
KONIEC
}

post_upgrade() {
    systemd-sysusers /usr/lib/sysusers.d/flotestro-relay.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/flotestro-relay.conf >/dev/null 2>&1 || true
    chown root:flotestro-relay /etc/flotestro/relay.yaml 2>/dev/null || true
    chmod 0640 /etc/flotestro/relay.yaml 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl try-restart flotestro-relay.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl disable --now flotestro-relay.service >/dev/null 2>&1 || true
}

post_remove() {
    # Tozsamosc relaya zostaje: ponowna instalacja ma ja odzyskac bez
    # enrollmentu.
    systemctl daemon-reload >/dev/null 2>&1 || true
}
