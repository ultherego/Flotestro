# Srodowisko uslugi agenta Flotestro.
#
# Ustawienia hosta opisuje /etc/flotestro/agent.yaml. Ten plik zostaje z dwoch
# powodow: niesie jednorazowy token enrollmentu i pozwala dzialac dalej
# hostom postawionym przed wprowadzeniem pliku YAML.
#
# Zmienne z tego pliku maja pierwszenstwo przed agent.yaml, wiec puste
# wartosci sa tu celowo: to agent.yaml ma rozstrzygac.

# Token enrollmentu wydany przez panel. Uzywany raz, przy pierwszym starcie;
# potem tozsamoscia agenta jest certyfikat, a nie token. Po zarejestrowaniu
# hosta mozna go stad usunac.
FLOTESTRO_ENROLLMENT_TOKEN=

# Ponizsze zostaja dla hostow sprzed wprowadzenia agent.yaml. Wypelnione
# nadpisuja plik YAML - zostaw je puste, jesli host ma isc konfiguracja.
FLOTESTRO_GATEWAY_URL=
FLOTESTRO_ENROLLMENT_URL=
FLOTESTRO_CA_FILE=
FLOTESTRO_AGENT_STATE_DIR=
FLOTESTRO_INVENTORY_MINUTES=
