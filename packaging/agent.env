# Konfiguracja agenta Flotestro.
#
# Plik jest oznaczony jako konfiguracyjny, wiec aktualizacja pakietu go nie
# nadpisuje. Zawiera adres panelu i jednorazowy token enrollmentu tego hosta,
# dlatego jest czytelny wylacznie dla roota i konta agenta.

# Adres bramy agentow (mTLS). Bez niego agent nie ma dokad sie polaczyc.
FLOTESTRO_GATEWAY_URL=

# Adres uslugi enrollmentu. Uzywany raz, do wydania certyfikatu hosta.
FLOTESTRO_ENROLLMENT_URL=

# Token enrollmentu wydany przez panel. Po zarejestrowaniu hosta traci
# znaczenie: tozsamoscia agenta jest certyfikat, a nie token.
FLOTESTRO_ENROLLMENT_TOKEN=

# Bundle CA floty. Agent weryfikuje nim panel; publiczne CA nie ma tu nic
# do rzeczy, bo obie strony uwierzytelniaja sie certyfikatami floty.
FLOTESTRO_CA_FILE=/var/lib/flotestro-agent/ca.pem

FLOTESTRO_AGENT_STATE_DIR=/var/lib/flotestro-agent

# Co ile minut agent wysyla pelny raport inventory.
FLOTESTRO_INVENTORY_MINUTES=15
