# The environment of the Flotestro agent service.
#
# The host settings are described by /etc/flotestro/agent.yaml. This file
# stays for one reason: it lets hosts set up before the YAML file was
# introduced keep working, and it is the place for an explicit override in
# an image or a test.
#
# Variables from this file take precedence over agent.yaml, so the empty
# values here are deliberate: agent.yaml is to decide.
#
# No enrollment token here. The daemon does not enroll and ignores
# FLOTESTRO_ENROLLMENT_TOKEN; a token is a one-time secret and goes to the
# operator's command, which asks for it without echo or reads it from a
# file with narrowed permissions:
#   sudo -u flotestro-agent flotestro-agentctl enroll
#   sudo -u flotestro-agent flotestro-agentctl enroll --token-file /path/to/token

# The following stay for hosts from before agent.yaml was introduced. When
# filled in they override the YAML file - leave them empty if the host is to
# follow the configuration file.
FLOTESTRO_GATEWAY_URL=
FLOTESTRO_ENROLLMENT_URL=
FLOTESTRO_CA_FILE=
FLOTESTRO_AGENT_STATE_DIR=
FLOTESTRO_INVENTORY_MINUTES=
