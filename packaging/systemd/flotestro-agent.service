[Unit]
Description=Flotestro agent
Documentation=https://github.com/ultherego/flotestro
After=network-online.target flotestro-helper.socket
Wants=network-online.target flotestro-helper.socket

# Demon startuje dopiero wtedy, gdy jest czym sie przedstawic. Host bez
# konfiguracji albo przed enrollmentem nie ma sie gdzie polaczyc, a petla
# restartow zasmieca dziennik i wyglada jak awaria - zamiast jak host, ktory
# czeka na rejestracje.
ConditionPathExists=/etc/flotestro/agent.yaml
# Tozsamosc w magazynie generacji albo, dla hostow sprzed jego wprowadzenia,
# w starym ukladzie plikow. Wystarczy jedna z nich.
ConditionPathExists=|/var/lib/flotestro-agent/identity/current/agent.pem
ConditionPathExists=|/var/lib/flotestro-agent/agent.pem

[Service]
Type=simple
User=flotestro-agent
Group=flotestro-agent
# Plik srodowiska jest opcjonalny i taki ma zostac: ustawienia hosta opisuje
# agent.yaml, a to jest tylko miejsce na override i na jednorazowy token.
# Jego brak nie moze zatrzymac uslugi - pakiet Archa go nie niesie.
EnvironmentFile=-/etc/flotestro/agent.env
ExecStart=/usr/bin/flotestro-agent
Restart=always
RestartSec=5s

# Budzet zasobow agenta jest wymuszony przez systemd, a nie tylko deklarowany.
#
# Budzet musi pokryc to, co agent naprawde robi. Narzedzia pakietowe dzialaja
# jako jego procesy potomne i trafiaja do tej samej grupy: samo rozwiazanie
# zaleznosci przez apt siega 75 MB (Debian 13, pomiar na flocie testowej).
# Wczesniejsze 48M nie konczylo sie czytelnym bledem - jadro dlawilo alokacje
# i spychalo host w swap, wiec planowanie aktualizacji trwalo dziesiatki sekund
# zamiast sekund, a operacje czekajace za nim wygladaly na zawieszone.
#
# Agent sam w sobie miesci sie w kilkudziesieciu megabajtach; reszta budzetu
# jest dla menedzera pakietow. Jednoczesnie moze dzialac jedna operacja
# pakietowa, wiec szczyt to agent plus jeden resolver.
MemoryHigh=192M
MemoryMax=256M
CPUWeight=20
IOWeight=20

# Agent nie potrzebuje roota ani zapisu poza wlasnym katalogiem stanu.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
StateDirectory=flotestro-agent
StateDirectoryMode=0700
# Agent laczy sie z gniazdem helpera, a to wymaga prawa zapisu do samego
# gniazda; ProtectSystem=strict montuje reszte systemu tylko do odczytu.
ReadWritePaths=/var/lib/flotestro-agent /run/flotestro

[Install]
WantedBy=multi-user.target
