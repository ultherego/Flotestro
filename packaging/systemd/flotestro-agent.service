[Unit]
Description=Flotestro agent
Documentation=https://github.com/ultherego/flotestro
After=network-online.target flotestro-helper.socket
Wants=network-online.target flotestro-helper.socket

# The daemon starts only when there is something to introduce itself with.
# A host without a configuration or before enrollment has nowhere to
# connect, and a restart loop litters the journal and looks like a failure -
# instead of like a host waiting for enrollment.
ConditionPathExists=/etc/flotestro/agent.yaml
# The identity in the generation store or, for hosts from before it was
# introduced, in the old file layout. Either one is enough.
ConditionPathExists=|/var/lib/flotestro-agent/identity/current/agent.pem
ConditionPathExists=|/var/lib/flotestro-agent/agent.pem

[Service]
Type=simple
User=flotestro-agent
Group=flotestro-agent
# The environment file is optional and is to stay so: the host settings are
# described by agent.yaml, and this is only a place for overrides and the
# one-time token. Its absence must not stop the service - the Arch package
# does not carry it.
EnvironmentFile=-/etc/flotestro/agent.env
ExecStart=/usr/bin/flotestro-agent
Restart=always
RestartSec=5s

# The agent resource budget is enforced by systemd, not merely declared.
#
# The budget must cover what the agent really does. The package tools run as
# its child processes and land in the same group: dependency resolution by
# apt alone reaches 75 MB (Debian 13, measured on the test fleet). The
# earlier 48M did not end with a readable error - the kernel throttled the
# allocations and pushed the host into swap, so planning an update took tens
# of seconds instead of seconds, and the operations waiting behind it looked
# hung.
#
# The agent itself fits in a few dozen megabytes; the rest of the budget is
# for the package manager. One package operation may run at a time, so the
# peak is the agent plus one resolver.
MemoryHigh=192M
MemoryMax=256M
CPUWeight=20
IOWeight=20

# The agent needs neither root nor writes outside its own state directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
StateDirectory=flotestro-agent
StateDirectoryMode=0700
# The agent connects to the helper socket, and that requires write access to
# the socket itself; ProtectSystem=strict mounts the rest of the system
# read-only.
ReadWritePaths=/var/lib/flotestro-agent /run/flotestro

[Install]
WantedBy=multi-user.target
