[Unit]
Description=Helper Flotestro (operacje wymagajace roota)
Documentation=https://github.com/ultherego/flotestro
Requires=flotestro-helper.socket
After=flotestro-helper.socket

[Service]
Type=simple
# Helper dziala jako root, ale jest uruchamiany wylacznie przez aktywacje
# gniazdem i konczy prace po okresie bezczynnosci. W spoczynku floty nie
# dziala zaden proces uprzywilejowany.
ExecStart=/usr/bin/flotestro-agent-helper
Environment=FLOTESTRO_AGENT_USER=flotestro-agent
Environment=FLOTESTRO_HELPER_IDLE_SECONDS=300

# Helper nie nasluchuje na sieci - jedynym wejsciem jest gniazdo unixowe - ale
# transakcje pakietowe musza pobierac pakiety z repozytorium, wiec ruch
# wychodzacy jest konieczny. Control plane celowo nie posredniczy w pobieraniu.
# AF_NETLINK jest tu konieczne: przez netlink rozmawiaja z jadrem nft i ip,
# a wiec caly modul zapory i odczyt stanu sieci. Bez tej rodziny nft konczy
# sie kodem 3 i komunikatem, ktory nie mowi o gniazdach ani slowa - a modul
# zapory wyglada wtedy na host bez regul.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# NoNewPrivileges=yes blokuje przejscia domen SELinuksa przy execve. Skrypty
# pakietow rpm przechodza do domeny rpm_script_t, wiec na Fedorze i RHEL-u nie
# daja sie uruchomic - transakcja konczy sie bledem "scriptlet failed" albo
# cicho nie robi nic, a przyczyny nie widac ani w dzienniku, ani w audycie.
#
# Helper i tak dziala jako root, wiec ta dyrektywa niczego mu nie odbierala:
# nie ma czego eskalowac. Granica jest gniazdo, weryfikacja SO_PEERCRED
# i zamknieta lista operacji - a nie flagi, ktore udaja, ze proces jest
# nieuprzywilejowany.
NoNewPrivileges=no
PrivateTmp=yes
# Helper zarzadza plikami authorized_keys w katalogach domowych, wiec /home
# musi byc dla niego widoczny. ProtectHome nie chronilby tu przed niczym:
# proces i tak dziala jako root i to on jest granica uprawnien.
ProtectHome=no
# ProtectKernelModules=yes podstawia pusty katalog w miejsce /lib/modules.
# Skrypty pakietow buduja z niego initramfs, wiec transakcja pakietowa
# wyprodukowalaby obraz bez sterownika dysku i host nie wstalby po restarcie.
# Ochrona i tak nie stanowilaby granicy: helper dziala jako root i moze
# ladowac moduly. Granica jest gniazdo i weryfikacja SO_PEERCRED.
ProtectKernelModules=no
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# Narzedzia pakietowe potrzebuja zapisywalnego HOME; katalog stanu jest
# tworzony i sprzatany przez systemd.
StateDirectory=flotestro-helper
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
