[Unit]
Description=Flotestro helper socket
Documentation=https://github.com/ultherego/flotestro

[Socket]
ListenStream=/run/flotestro/helper.sock
SocketMode=0660
SocketUser=root
SocketGroup=flotestro-agent
# Only the agent may connect. The helper additionally verifies the peer
# identity through SO_PEERCRED, so the socket permissions are not the only
# control.
Accept=no

[Install]
WantedBy=sockets.target
