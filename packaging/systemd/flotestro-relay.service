[Unit]
Description=Flotestro site relay
Documentation=https://github.com/ultherego/flotestro
After=network-online.target
Wants=network-online.target

# A relay without a configuration and without an identity has nowhere to
# connect and nothing to present to the agents. A restart loop would litter
# the journal of a machine that simply waits for enrollment.
ConditionPathExists=/etc/flotestro/relay.yaml
ConditionPathExists=/var/lib/flotestro-relay/identity/current/agent.pem

[Service]
Type=simple
User=flotestro-relay
Group=flotestro-relay
ExecStart=/usr/bin/flotestro-relay run --config /etc/flotestro/relay.yaml
Restart=on-failure
RestartSec=5s

# The relay terminates the TLS of the whole site and carries out no
# operations on the host: there is no helper here and no reason to give more
# privileges.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
StateDirectory=flotestro-relay
StateDirectoryMode=0700
ReadWritePaths=/var/lib/flotestro-relay

# The result buffer has a limit in the configuration, but the process limit
# is harder: a link outage must not turn into an outage of the site
# machine.
LimitNOFILE=131072
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
