[Unit]
Description=Flotestro host enrollment
Documentation=https://github.com/ultherego/flotestro
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/flotestro/agent.yaml
# Enrollment concerns a host that has no identity yet. An already enrolled
# host has nothing to look for here - the unit simply does not start.
ConditionPathExists=!/var/lib/flotestro-agent/identity/current/agent.pem

[Service]
Type=oneshot
User=flotestro-agent
Group=flotestro-agent
# The token comes as a systemd credential, not in the environment nor in
# the arguments: an argument is seen by every user of the host in the
# process list, and an environment variable stays in the service file for
# good.
LoadCredential=enrollment-token:/run/flotestro-bootstrap/enrollment-token
ExecStart=/usr/bin/flotestro-agentctl enroll --config /etc/flotestro/agent.yaml --token-file %d/enrollment-token

StateDirectory=flotestro-agent
StateDirectoryMode=0700
ReadWritePaths=/var/lib/flotestro-agent
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
