# The configuration of the Flotestro control plane.
#
# The file is marked as a configuration file, so a package update does not
# overwrite it. It holds the database credentials, which is why it is
# readable only by root and the service account.

# The PostgreSQL connection. The database is the only source of truth; the
# panel keeps the fleet state nowhere else. The schema is created and
# migrated by the panel itself at startup.
FLOTESTRO_DATABASE_URL=postgres://flotestro:change-me@127.0.0.1:5432/flotestro

# The address of the REST API and the web panel.
#
# By default the panel listens only on the loopback: the administrative
# interface must not expose itself to the network merely by installing the
# package. To make it available to operators, set an address visible in the
# network here - preferably behind a reverse proxy with TLS, because this
# connection goes over HTTP.
FLOTESTRO_ADMIN_ADDR=127.0.0.1:8080

# The agent gateway (mTLS) and the enrollment (TLS). Both ports must be
# reachable for the fleet hosts; the traffic is encrypted with the fleet CA
# certificates.
FLOTESTRO_GATEWAY_ADDR=:8443
FLOTESTRO_ENROLLMENT_ADDR=:8444

# The addresses and names the agents see the panel under; comma-separated.
# They enter the server certificate of the agent gateway, so without them an
# agent rejects the connection: the certificate issued by default covers
# only 127.0.0.1 and suits only an installation where everything runs on one
# machine.
FLOTESTRO_ADVERTISE=

# The panel address visible to the browser. Used at logout and when deciding
# on the Secure flag of the session cookies.
FLOTESTRO_PUBLIC_URL=

# The base address of the signed package repository, e.g.
# https://packages.example.org/flotestro. The "Add host" screen composes the
# installation commands from it: the repository key is expected under
# <address>/flotestro-repo.asc, the packages under <address>/deb, /rpm and
# /arch, as sign-repo.sh lays them out. Empty leaves a placeholder in the
# commands for the operator to replace.
FLOTESTRO_PACKAGE_REPOSITORY_URL=

# The identity provider (OIDC). Empty disables browser login; the panel then
# works on API tokens.
FLOTESTRO_OIDC_ISSUER=
FLOTESTRO_OIDC_CLIENT_ID=flotestro-panel
FLOTESTRO_OIDC_CLIENT_SECRET=
# Optional: when a user is disabled from the panel, end their sessions at the
# identity provider as well, so the provider does not keep logging them into
# other applications until its own session runs out. Keycloak only: the
# issuer has to be a realm (.../realms/<name>), and the client above needs a
# service account with the realm management roles view-users and
# manage-users. The panel's local denial holds without it.
FLOTESTRO_OIDC_ADMIN_LOGOUT=false

# The identity directory (FreeIPA). Empty disables the whole directory
# module; the panel then manages local accounts on the hosts.
FLOTESTRO_IPA_URL=
FLOTESTRO_IPA_PRINCIPAL=
FLOTESTRO_IPA_KEYTAB=

# Directory changes are a separate module and are disabled by default: an
# installation may want the view alone and make the changes with its own
# tools.
FLOTESTRO_DIRECTORY_WRITE=false

# Operations that change access rules require fresh authentication. The
# level (acr) depends on the identity provider configuration; empty means
# the installation did not define one and only the freshness condition
# remains.
FLOTESTRO_STEPUP_MAX_AGE=5m
FLOTESTRO_STEPUP_ACR=

# How long a browser session survives without a request before it ends.
# The absolute limit of a session is 24 hours regardless of activity.
FLOTESTRO_SESSION_IDLE=8h

# Whether an API token may carry out those operations at all. "allow" lets
# automation change access rules, secrets and identities, and the audit
# trail records that no authentication was refreshed; "refuse" demands a
# browser session with fresh authentication, so a person stands behind
# every such change.
FLOTESTRO_STEPUP_TOKENS=allow

# Production environments require a second person to approve changes.
FLOTESTRO_PRODUCTION_ENVIRONMENTS=prod,production

# Notifications. The panel posts the events of its durable trail - the
# course of every campaign and of every host in it - to this address in
# batches, signed with HMAC-SHA256 (X-Flotestro-Signature) over the
# delivery timestamp (X-Flotestro-Timestamp, Unix seconds), a dot and the
# body: a receiver that checks the timestamp against its clock refuses a
# replayed delivery. A signature over the body alone is still accepted by
# the verifier of this release for receivers that have not moved yet.
# The delivery is at least once and in order: a receiver that is down
# loses nothing, and deduplicates by the event identifier when it is back.
# Empty disables the webhook. The prefixes narrow the events, e.g.
# "campaign." for the campaign phases alone.
FLOTESTRO_WEBHOOK_URL=
FLOTESTRO_WEBHOOK_SECRET=
FLOTESTRO_WEBHOOK_EVENTS=

# Vulnerability feeds. The panel - never the hosts - reads the trackers of
# the distributions; the hosts only report their packages. An installation
# without Internet access points these at an internal mirror, or at copies
# brought onto the panel by hand with a file:// address, e.g.
# file:///var/lib/flotestro/feeds/debian.json - a copied file is read the
# same way as the remote feed, with its age marked when it grows stale.
# Empty disables a source; FLOTESTRO_VULN_ENABLED=false disables the
# correlator altogether.
#FLOTESTRO_VULN_DEBIAN_URL=https://security-tracker.debian.org/tracker/data/json
#FLOTESTRO_VULN_UBUNTU_URL=https://security-metadata.canonical.com/oval/
#FLOTESTRO_VULN_REDHAT_URL=https://security.access.redhat.com/data/csaf/v2/vex/
#FLOTESTRO_VULN_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# The built-in monitoring. The agents sample their host every minute and
# the panel keeps the samples itself: the raw ones for the short charts,
# the quarter-hour rollups for the long ones. Longer keeps more history at
# the cost of the database; a large fleet may want the raw window shorter.
FLOTESTRO_METRICS_RETENTION_RAW=48h
FLOTESTRO_METRICS_RETENTION_ROLLUP=720h

# How many task envelopes the gateway sends per second, with a burst of one
# second's worth: a queue of thousands after an outage drains at this pace
# rather than in one wave that starts every host at the same moment. A task
# the rate has no token for stays queued, not leased, and is counted in
# flotestro_dispatch_throttled_total. Zero turns the pacing off.
FLOTESTRO_DISPATCH_RATE=100

# What the gateway does when the same identity is alive on two boots at
# once - a cloned image, or a replay of a captured key. "quarantine" ends
# both sessions with the reason duplicate_identity, puts the host into
# quarantine and cancels its queued tasks: neither machine acts under the
# identity until an operator has decided which of them is the host, with
# an identity recovery for that one or a release once the copy is gone.
# "report" records and counts the incident and lets the newer session
# stand, for an installation that assesses every clone by hand. Both
# record the incident in the audit trail with the policy applied. A
# sighting from the host's own address - the machine back from a crash
# before the gateway noticed its old session die - is reported under
# either policy and never quarantined.
FLOTESTRO_CLONE_POLICY=quarantine

# The audit trail is evidence and is kept forever by default. An
# installation that keeps it elsewhere - through the webhook, or by a
# database export - may set a retention here, e.g. 8760h for a year; the
# events older than that are deleted once an hour. The ended sessions of
# the agents are swept after thirty days regardless.
FLOTESTRO_AUDIT_RETENTION=0

# The key of the secret store lies in the state directory (secrets.key)
# unless pointed elsewhere; without a copy of it the secrets cannot be
# recovered. Every value is bound to its row: a ciphertext moved to
# another secret or another version does not open. Values written by a
# release before this binding still open and are bound at the next
# rotation of their secret.
#FLOTESTRO_SECRETS_KEY_FILE=/var/lib/flotestro/secrets.key

FLOTESTRO_STATE_DIR=/var/lib/flotestro
FLOTESTRO_WEB_ROOT=/usr/share/flotestro/web
