# Konfiguracja control plane Flotestro.
#
# Plik jest oznaczony jako konfiguracyjny, wiec aktualizacja pakietu go nie
# nadpisuje. Zawiera poswiadczenia do bazy, dlatego jest czytelny wylacznie
# dla roota i konta uslugi.

# Polaczenie do PostgreSQL. Baza jest jedynym zrodlem prawdy; panel nie
# przechowuje stanu floty nigdzie indziej. Schemat jest zakladany
# i migrowany przez sam panel przy starcie.
FLOTESTRO_DATABASE_URL=postgres://flotestro:zmien-to@127.0.0.1:5432/flotestro

# Adres panelu widoczny dla przegladarki. Uzywany przy wylogowaniu
# i przy decyzji o fladze Secure ciasteczek sesji.
FLOTESTRO_PUBLIC_URL=

# Dostawca tozsamosci (OIDC). Puste wylacza logowanie przez przegladarke;
# panel dziala wtedy na tokenach API.
FLOTESTRO_OIDC_ISSUER=
FLOTESTRO_OIDC_CLIENT_ID=flotestro-panel
FLOTESTRO_OIDC_CLIENT_SECRET=

# Katalog tozsamosci (FreeIPA). Puste wylacza caly modul katalogu; panel
# zarzadza wtedy kontami lokalnymi na hostach.
FLOTESTRO_IPA_URL=
FLOTESTRO_IPA_PRINCIPAL=
FLOTESTRO_IPA_KEYTAB=

# Zmiany w katalogu sa osobnym modulem i domyslnie sa wylaczone: instalacja
# moze chciec samego widoku, a zmiany robic wlasnymi narzedziami.
FLOTESTRO_DIRECTORY_WRITE=false

# Operacje przestawiajace reguly dostepu wymagaja swiezego uwierzytelnienia.
# Poziom (acr) zalezy od konfiguracji dostawcy tozsamosci; puste znaczy, ze
# instalacja go nie zdefiniowala i zostaje sam warunek swiezosci.
FLOTESTRO_STEPUP_MAX_AGE=5m
FLOTESTRO_STEPUP_ACR=

# Srodowiska produkcyjne wymagaja drugiej osoby przy zatwierdzaniu zmian.
FLOTESTRO_PRODUCTION_ENVIRONMENTS=prod,production

FLOTESTRO_STATE_DIR=/var/lib/flotestro
FLOTESTRO_WEB_ROOT=/usr/share/flotestro/web
