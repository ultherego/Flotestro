# The configuration of the Flotestro control plane.
#
# The file is marked as a configuration file, so a package update does not
# overwrite it. It holds the database credentials, which is why it is
# readable only by root and the service account.

# The PostgreSQL connection. The database is the only source of truth; the
# panel keeps the fleet state nowhere else. The schema is created and
# migrated by the panel itself at startup.
FLOTESTRO_DATABASE_URL=postgres://flotestro:change-me@127.0.0.1:5432/flotestro

# The address of the REST API and the web panel.
#
# By default the panel listens only on the loopback: the administrative
# interface must not expose itself to the network merely by installing the
# package. To make it available to operators, set an address visible in the
# network here - preferably behind a reverse proxy with TLS, because this
# connection goes over HTTP.
FLOTESTRO_ADMIN_ADDR=127.0.0.1:8080

# The agent gateway (mTLS) and the enrollment (TLS). Both ports must be
# reachable for the fleet hosts; the traffic is encrypted with the fleet CA
# certificates.
FLOTESTRO_GATEWAY_ADDR=:8443
FLOTESTRO_ENROLLMENT_ADDR=:8444

# The addresses and names the agents see the panel under; comma-separated.
# They enter the server certificate of the agent gateway, so without them an
# agent rejects the connection: the certificate issued by default covers
# only 127.0.0.1 and suits only an installation where everything runs on one
# machine.
FLOTESTRO_ADVERTISE=

# The panel address visible to the browser. Used at logout and when deciding
# on the Secure flag of the session cookies.
FLOTESTRO_PUBLIC_URL=

# The identity provider (OIDC). Empty disables browser login; the panel then
# works on API tokens.
FLOTESTRO_OIDC_ISSUER=
FLOTESTRO_OIDC_CLIENT_ID=flotestro-panel
FLOTESTRO_OIDC_CLIENT_SECRET=

# The identity directory (FreeIPA). Empty disables the whole directory
# module; the panel then manages local accounts on the hosts.
FLOTESTRO_IPA_URL=
FLOTESTRO_IPA_PRINCIPAL=
FLOTESTRO_IPA_KEYTAB=

# Directory changes are a separate module and are disabled by default: an
# installation may want the view alone and make the changes with its own
# tools.
FLOTESTRO_DIRECTORY_WRITE=false

# Operations that change access rules require fresh authentication. The
# level (acr) depends on the identity provider configuration; empty means
# the installation did not define one and only the freshness condition
# remains.
FLOTESTRO_STEPUP_MAX_AGE=5m
FLOTESTRO_STEPUP_ACR=

# Production environments require a second person to approve changes.
FLOTESTRO_PRODUCTION_ENVIRONMENTS=prod,production

FLOTESTRO_STATE_DIR=/var/lib/flotestro
FLOTESTRO_WEB_ROOT=/usr/share/flotestro/web
