; What this tree already uses, read off the files rather than chosen.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,jsx,css,json}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[*.md]
; Two trailing spaces are a line break in Markdown, so they are left alone.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
