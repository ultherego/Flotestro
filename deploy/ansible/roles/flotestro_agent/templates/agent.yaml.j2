# A file generated by Ansible. Manual changes are lost at the next run - the
# host configuration belongs to the automation, not to the machine.
#
# There is no token nor identity here: the token is a one-time secret, and
# the identity comes from the certificate issued by the panel.
schema_version: 1

connection:
  enrollment_url: "{{ flotestro_agent_enrollment_url }}"
  gateway_urls:
{% for address in flotestro_agent_gateway_urls %}
    - "{{ address }}"
{% endfor %}
  bootstrap_ca_file: "{{ flotestro_agent_state_dir }}/ca.pem"
  connect_timeout: "15s"
  reconnect_min: "2s"
  reconnect_max: "2m"

agent:
  state_dir: "{{ flotestro_agent_state_dir }}"
  inventory_interval: "{{ flotestro_agent_inventory_interval }}"
  max_concurrent_tasks: {{ flotestro_agent_max_concurrent_tasks }}
  mode: "{{ flotestro_agent_mode }}"

helper:
  socket: "/run/flotestro/helper.sock"
