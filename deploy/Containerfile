# syntax=docker/dockerfile:1.7

# The image of the control plane and the image of the relay come out of one
# file. They are built from one source tree, share the build of the panel and
# the toolchain, and must never drift apart in their version: an agent talks
# to both, and a relay from another release is a support case nobody can see.
#
# The final images are distroless. They carry the binaries, the certificate
# store of the system and the built panel, and nothing else - no shell, no
# package manager, no PostgreSQL client and no Docker CLI. Debugging happens
# through a support bundle or a separate tools image; the database has its own
# lifecycle, its own backup and its own tuning, so it is never in here.
#
# Build (one architecture, for a laboratory):
#   docker build -f deploy/Containerfile --target control-plane \
#     --build-arg VERSION=0.54.0 -t flotestro-control-plane:0.54.0 .
#
# Build (the official platforms, pushed to the registry):
#   docker buildx build -f deploy/Containerfile --target control-plane \
#     --platform linux/amd64,linux/arm64 \
#     --build-arg VERSION=0.54.0 \
#     --build-arg COMMIT="$(git rev-parse HEAD)" \
#     --build-arg BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
#     -t ghcr.io/ultherego/flotestro-control-plane:0.54.0 --push .
#
# The build context is the repository root, and the allowlist that keeps it
# to the sources is the .dockerignore file there.

ARG GO_IMAGE=golang:1.25-bookworm
ARG NODE_IMAGE=node:22-bookworm-slim
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot
# The tags above name the family of an image. A production build pins each of
# them by digest (image:tag@sha256:...) and moves a digest in a separate
# change, after the images behind it were tested; a tag may be rewritten by
# whoever publishes it, a digest may not.

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS web-build
WORKDIR /src/web
# The manifests first and on their own: the layer with the dependencies is
# then rebuilt when the dependencies change and not when a component does.
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,id=flotestro-npm,target=/root/.npm \
    npm ci --no-audit --no-fund
COPY web/ ./
# The panel is built with the network switched off. Everything it needs came
# from the lockfile above, and a build that could still reach out might pull
# in something the lockfile does not name.
RUN --network=none npm run build

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS go-build
WORKDIR /src
ARG TARGETOS TARGETARCH VERSION=dev COMMIT=unknown BUILD_DATE=unknown

# The provenance is written into every binary, not only into the control
# plane: "which commit is this" is asked about auditverify and about the
# relay just as often, and a binary that answers with the compiled-in default
# tells nobody anything. The symbol paths are the ones the release script
# stamps, so a container build and a package build describe themselves in the
# same words.
ENV BUILD_LDFLAGS="-s -w \
    -X github.com/ultherego/flotestro/internal/buildinfo.Version=${VERSION} \
    -X github.com/ultherego/flotestro/internal/buildinfo.Commit=${COMMIT} \
    -X github.com/ultherego/flotestro/internal/buildinfo.Date=${BUILD_DATE}"

COPY go.mod go.sum ./
RUN --mount=type=cache,id=flotestro-gomod,target=/go/pkg/mod go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
# The migrations are embedded in the control plane binary (db/embed.go), so
# the directory has to be in the build context although nothing copies it
# into the final image.
COPY db/ ./db/

# CGO is off: the binary is to run on the distroless image, which has no libc
# to link against. timetzdata carries the time zone database in the binary -
# the image has no /usr/share/zoneinfo, and a campaign window or a timer
# written in a named zone must not fall back to UTC in silence. -trimpath
# removes the paths of the build machine, so the same source gives the same
# binary wherever it is built.
RUN --mount=type=cache,id=flotestro-gobuild,target=/root/.cache/go-build \
    --mount=type=cache,id=flotestro-gomod,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -tags timetzdata -trimpath -ldflags="${BUILD_LDFLAGS}" \
      -o /out/flotestro-control-plane ./cmd/control-plane

RUN --mount=type=cache,id=flotestro-gobuild,target=/root/.cache/go-build \
    --mount=type=cache,id=flotestro-gomod,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -ldflags="${BUILD_LDFLAGS}" \
      -o /out/flotestro-auditverify ./cmd/auditverify

RUN --mount=type=cache,id=flotestro-gobuild,target=/root/.cache/go-build \
    --mount=type=cache,id=flotestro-gomod,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -tags timetzdata -trimpath -ldflags="${BUILD_LDFLAGS}" \
      -o /out/flotestro-relay ./cmd/relay && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -ldflags="${BUILD_LDFLAGS}" \
      -o /out/flotestro-relayctl ./cmd/relayctl

RUN --mount=type=cache,id=flotestro-gobuild,target=/root/.cache/go-build \
    --mount=type=cache,id=flotestro-gomod,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -ldflags="${BUILD_LDFLAGS}" \
      -o /out/flotestro-healthcheck ./cmd/container-healthcheck

# The state directories are prepared here and copied whole, with their owner
# and their mode: a named volume mounted over such a directory inherits them
# from the image, and the container must never be started as root merely to
# chown its own state. The parents stay as the system has them - only the
# state itself belongs to the service account alone.
RUN install -d -m 0755 /out/rootfs-control-plane/var /out/rootfs-control-plane/var/lib \
        /out/rootfs-relay/var /out/rootfs-relay/var/lib && \
    install -d -m 0700 -o 65532 -g 65532 \
        /out/rootfs-control-plane/var/lib/flotestro \
        /out/rootfs-relay/var/lib/flotestro-relay

FROM --platform=$TARGETPLATFORM ${RUNTIME_IMAGE} AS control-plane

ARG VERSION COMMIT BUILD_DATE
LABEL org.opencontainers.image.title="Flotestro control plane" \
      org.opencontainers.image.source="https://github.com/ultherego/Flotestro" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

COPY --from=go-build /out/flotestro-control-plane /usr/local/bin/
COPY --from=go-build /out/flotestro-auditverify /usr/local/bin/
COPY --from=go-build /out/flotestro-healthcheck /usr/local/bin/
COPY --from=web-build --chown=65532:65532 /src/web/dist/ /usr/share/flotestro/web/
COPY --from=go-build /out/rootfs-control-plane/ /

# The listeners bind to every address, unlike the native installation, where
# the admin listener stays on the loopback. Between containers the loopback
# reaches nothing; what limits the exposure here is the port mapping and the
# network, and the mapping in the Compose file publishes 8080 on the host
# loopback alone.
ENV FLOTESTRO_STATE_DIR=/var/lib/flotestro \
    FLOTESTRO_WEB_ROOT=/usr/share/flotestro/web \
    FLOTESTRO_ADMIN_ADDR=0.0.0.0:8080 \
    FLOTESTRO_GATEWAY_ADDR=0.0.0.0:8443 \
    FLOTESTRO_ENROLLMENT_ADDR=0.0.0.0:8444

USER 65532:65532
EXPOSE 8080 8443 8444
STOPSIGNAL SIGTERM
# The health client reads FLOTESTRO_ADMIN_ADDR above, so a moved listener
# moves the check with it. The start period covers the first start of an
# installation, which migrates the schema before it listens.
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD ["/usr/local/bin/flotestro-healthcheck"]
ENTRYPOINT ["/usr/local/bin/flotestro-control-plane"]

# No VOLUME is declared here. A volume declared in the image is anonymous,
# and an anonymous volume with the fleet CA in it is the one thing an
# operator must not be able to lose by accident; the persistent mounts are
# named explicitly in the Compose files.

FROM --platform=$TARGETPLATFORM ${RUNTIME_IMAGE} AS relay

ARG VERSION COMMIT BUILD_DATE
LABEL org.opencontainers.image.title="Flotestro relay" \
      org.opencontainers.image.source="https://github.com/ultherego/Flotestro" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

COPY --from=go-build /out/flotestro-relay /usr/local/bin/
COPY --from=go-build /out/flotestro-relayctl /usr/local/bin/
COPY --from=go-build /out/flotestro-healthcheck /usr/local/bin/
COPY --from=go-build /out/rootfs-relay/ /

USER 65532:65532
EXPOSE 8453
STOPSIGNAL SIGTERM
# No HEALTHCHECK in the relay image. The relay is configured by a file and
# not by the environment, so the image cannot know which address it will
# listen on, and the liveness check therefore stands in compose.relay.yaml
# next to the file that decides it.
ENTRYPOINT ["/usr/local/bin/flotestro-relay"]
CMD ["run", "-config", "/etc/flotestro/relay.yaml"]
