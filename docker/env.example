# Settings for docker/compose.yaml. Copy it to .env beside that file:
#
#   curl -fsSLO https://raw.githubusercontent.com/ultherego/Flotestro/main/docker/env.example
#   mv env.example .env
#
# Nothing here is required. Every key has the default this file shows, and a
# quickstart on this machine works without the file at all. Secrets never go
# in here: an environment variable is visible in "docker inspect", in the
# process list and in a crash dump. They are files, made by the init service
# or mounted by you - a key whose name ends in _FILE takes a path, not a value.
#
# The sections below are the order a deployment grows in: the three a fleet
# needs, then the database, then whatever the company already runs.

#============================================================================#
#                          THE THREE A FLEET NEEDS                           #
#============================================================================#

# The addresses and names the agents reach this panel at, comma-separated.
# They enter the certificate of the agent gateway. The default serves a trial
# on this machine only: a remote host cannot enrol against 127.0.0.1, and the
# panel refuses such an enrollment instead of issuing a certificate no agent
# would accept.
FLOTESTRO_ADVERTISE=127.0.0.1

# The address an operator opens the panel at. The OIDC redirect and the Secure
# flag of the session cookies follow from it, so https here means the cookies
# are marked Secure.
FLOTESTRO_PUBLIC_URL=http://localhost:8080

# The release. "latest" follows every new stable version; an installation that
# should change only when you say so pins one, for example 0.60.1.
FLOTESTRO_VERSION=latest

#============================================================================#
#                                  DATABASE                                  #
#============================================================================#

# Whether this process brings the schema up to date at its own start. The
# migrate service does it, so this is false in both profiles.
#FLOTESTRO_AUTO_MIGRATE=false

# The role the migration takes on, so what it creates belongs to the schema
# owner and not to whoever ran the command.
#FLOTESTRO_MIGRATION_ROLE=flotestro_owner

# A database somebody else runs: do not start the quickstart profile. Put the
# DSN in ./secrets/database-url before the first start - one line, no newline
# needed:
#
#   postgresql://flotestro:PASSWORD@db.example.org:5432/flotestro?sslmode=verify-full
#
# The init service copies it in and gives it to the account the panel runs as.
# It wins over anything generated earlier, so this is also how the password is
# changed: write the new DSN and start the deployment again.

#============================================================================#
#                                  NETWORK                                   #
#============================================================================#

# Where the REST API and the panel are published. Every address of this host by
# default, because the panel is opened from another machine. Over plain HTTP the
# bootstrap token and every administrative request travel in clear on the
# network: that is accepted for a laboratory, and an installation beyond one puts
# TLS in front of the panel and narrows this to 127.0.0.1.
#FLOTESTRO_API_PUBLISH=0.0.0.0

# The name of this gateway. A second replica of the same installation must
# carry a different one: sessions and scheduler leases are tagged with it.
#FLOTESTRO_GATEWAY_ID=cp-01

#============================================================================#
#                             PACKAGES AND FEEDS                             #
#============================================================================#

# Where the fleet fetches agent packages from. Empty means the hosts already
# have a repository of their own. The panel writes this address into the
# commands it composes under "Add host", so a fleet that installs from the
# project's own repository names it here:
#   https://ultherego.github.io/Flotestro/packages
#FLOTESTRO_PACKAGE_REPOSITORY_URL=

# The vulnerability feed. Unset uses the public NVD; a site with no route out
# copies the feed in and names it here.
#FLOTESTRO_VULN_NVD_URL=

#============================================================================#
#                           OIDC - SINGLE SIGN-ON                            #
#============================================================================#

# Optional in full: a panel with no identity provider is a finished
# installation, and operators then sign in with API tokens. Partial
# configuration is refused by name at start rather than half-applied.

# The issuer, exactly as the provider publishes it - the panel appends
# /.well-known/openid-configuration to it itself.
#FLOTESTRO_OIDC_ISSUER=https://sso.example.org/realms/company

# The client the panel is registered as, and the claim its groups arrive in.
#FLOTESTRO_OIDC_CLIENT_ID=flotestro-panel
#FLOTESTRO_OIDC_GROUPS_CLAIM=groups

# The client secret is a secret, so it travels as a path and never as a value.
# Mount the file in compose.yaml and name it here. Setting both this and
# FLOTESTRO_OIDC_CLIENT_SECRET is refused: a secret comes either from the
# environment or from a file, never from both.
#FLOTESTRO_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret

# Whether signing out of the panel also ends the session at the provider.
#FLOTESTRO_OIDC_ADMIN_LOGOUT=true

#============================================================================#
#                          FREEIPA - THE DIRECTORY                           #
#============================================================================#

# The directory connector, when there is one. A panel that names a server and a
# principal refuses to start when the connector cannot be built from them.
#
# The keytab, the Kerberos configuration and the CA are mounted files (see
# compose.yaml), because the image carries none of them. A path the panel is not
# told about is a file it never opens.

# One setting with two names; _URL wins when both are set.
#FLOTESTRO_IPA_URL=https://ipa.example.org
#FLOTESTRO_IPA_SERVER=

# The realm, and the service principal the panel binds as. The connector has its
# own principal and its own role: the panel never binds as the Directory Manager
# or as an administrator.
#FLOTESTRO_IPA_REALM=EXAMPLE.ORG
#FLOTESTRO_IPA_PRINCIPAL=flotestro/panel.example.org@EXAMPLE.ORG

# The three files, named with the path they have inside the container.
#FLOTESTRO_IPA_KEYTAB=/run/secrets/ipa.keytab
#FLOTESTRO_IPA_KRB5_CONF=/etc/flotestro/krb5.conf
#FLOTESTRO_IPA_CA_CERT=/run/secrets/ipa-ca.crt

# Whether the panel may change the directory or only read it. Read-only is the
# safe default: an installation that only observes cannot be made to write.
#FLOTESTRO_DIRECTORY_WRITE=false

# Diagnostic only, and loud about what it costs: the trace copies what the panel
# sends to the directory, so leave it off unless somebody is reading it.
#FLOTESTRO_IPA_TRACE=false

#============================================================================#
#                               NOTIFICATIONS                                #
#============================================================================#

# The networks a notification channel may reach. Empty refuses loopback,
# link-local and private addresses, so a channel cannot be pointed at the
# panel itself or at a cloud metadata service. An on-premise receiver is
# declared here: 10.0.0.0/8,192.168.0.0/16
#FLOTESTRO_NOTIFY_ALLOW=

#============================================================================#
#                              THE ROOT HELPER                               #
#============================================================================#

# What the panel does with the root helper's signed capability. enforce, the
# default of this deployment, holds a mutating task back rather than sending it
# unproved. prefer sends it anyway when a host's agent forwards no capability,
# which is what a fleet installed before the capability needs until every host
# is on enforce; observe never holds anything back and only counts.
#FLOTESTRO_HELPER_CAPABILITY_MODE=enforce

#============================================================================#
#                                   BACKUP                                   #
#============================================================================#

# The digest of the admin-tools image, written into the manifest of a backup
# so that a restore can say what took it.
#FLOTESTRO_TOOLS_DIGEST=
