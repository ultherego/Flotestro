# The administration tools: the backup pair, its restore and the check of an
# audit export. This is the one image of the set that cannot be distroless,
FROM --platform=$TARGETPLATFORM ${TOOLS_IMAGE} AS admin-tools

ARG VERSION COMMIT BUILD_DATE
LABEL org.opencontainers.image.title="Flotestro administration tools" \
      org.opencontainers.image.source="https://github.com/ultherego/Flotestro" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

# zstd for the state archive - the manifest names a .tar.zst and GNU tar
# calls the program - and jq to write and read the manifest itself, because
RUN apt-get update && \
    apt-get install -y --no-install-recommends zstd jq && \
    rm -rf /var/lib/apt/lists/*

COPY --from=go-build /out/flotestro-auditverify /usr/local/bin/

COPY --chmod=0755 <<'TOOL' /usr/local/bin/flotestro-admin-tools
#!/usr/bin/env bash
#
set -euo pipefail

backup_root="${FLOTESTRO_BACKUP_DIR:-/backups}"
state_dir="${FLOTESTRO_STATE_DIR:-/state}"

fail() {
    printf 'admin-tools: %s\n' "$1" >&2
    exit 1
}

note() {
    printf 'admin-tools: %s\n' "$1"
}

# Percent-decoding for the password of a URI: libpq decodes it out of the
# DSN, PGPASSWORD is taken literally, so a password written as %40 has to
urldecode() {
    local escaped="${2//\\/\\\\}"
    printf -v "$1" '%b' "${escaped//%/\\x}"
}

# The DSN is read from a file, as everywhere else in this deployment, and
# the password is lifted out of it before anything is executed: an argument
connect() {
    local path="${FLOTESTRO_DATABASE_URL_FILE:-}"
    if [ -z "$path" ]; then
        fail "FLOTESTRO_DATABASE_URL_FILE is not set; the DSN travels as a file, never as a value"
    fi
    if [ -n "${FLOTESTRO_DATABASE_URL:-}" ]; then
        fail "FLOTESTRO_DATABASE_URL and FLOTESTRO_DATABASE_URL_FILE are both set; which of the two was meant cannot be guessed"
    fi
    if [ -L "$path" ]; then
        fail "$path is a symbolic link; a secret is read from the file it is mounted as"
    fi
    if [ ! -f "$path" ]; then
        fail "$path is not a file"
    fi
    local size
    size="$(stat -c %s "$path")"
    if [ "$size" -eq 0 ]; then
        fail "$path is empty"
    fi
    if [ "$size" -gt 8192 ]; then
        fail "$path holds $size bytes; a DSN is not that long and this is not the file that was meant"
    fi
    local dsn
    dsn="$(cat "$path")"
    case "$dsn" in
        postgres://*|postgresql://*) ;;
        *) fail "the DSN in $path is not a postgres:// URI; the key=value form cannot have its password separated from the arguments and is refused here" ;;
    esac
    local scheme rest head tail userinfo user encoded
    scheme="${dsn%%://*}://"
    rest="${dsn#*://}"
    head="${rest%%/*}"
    tail="${rest#"$head"}"
    if [ "${head#*@}" != "$head" ]; then
        userinfo="${head%@*}"
        if [ "${userinfo#*:}" != "$userinfo" ]; then
            user="${userinfo%%:*}"
            encoded="${userinfo#*:}"
            urldecode PGPASSWORD "$encoded"
            export PGPASSWORD
            head="${user}@${head##*@}"
        fi
    fi
    CONNECTION="${scheme}${head}${tail}"
}

query() {
    psql --no-psqlrc --quiet --tuples-only --no-align \
        --set ON_ERROR_STOP=1 --dbname "$CONNECTION" --command "$1"
}

# A backup is addressed by its identifier and lies in a directory of its
# own, because the database and the state are one thing: a directory that
resolve() {
    local given="$1" dir
    if [ -z "$given" ]; then
        fail "give the identifier of the backup, for example 20260919T101500Z"
    fi
    if [ -d "$backup_root/$given" ]; then
        dir="$backup_root/$given"
    elif [ -d "$given" ]; then
        dir="$given"
    else
        fail "no backup $given under $backup_root"
    fi
    local expected
    expected="$(jq -r '.backup_id' "$dir/manifest.json")"
    if [ "$expected" != "$(basename "$dir")" ]; then
        fail "$dir/manifest.json describes the backup $expected; the manifest and the directory are from different pairs"
    fi
    printf '%s' "$dir"
}

checksums() {
    local dir="$1"
    ( cd "$dir" && sha256sum --check --strict --quiet SHA256SUMS ) ||
        fail "the files of $dir do not match the checksums written with them"
}

backup() {
    connect
    if [ ! -d "$state_dir" ]; then
        fail "$state_dir is not a directory; the state volume of the control plane is mounted there"
    fi
    if [ ! -f "$state_dir/ca.pem" ]; then
        fail "$state_dir carries no ca.pem, so it is not the state of an installation; half a pair is not a backup"
    fi
    if [ ! -w "$backup_root" ]; then
        fail "$backup_root is not writable by this container (uid $(id -u)); the directory on the host belongs to that user"
    fi
    local id dir
    id="$(date -u +%Y%m%dT%H%M%SZ)"
    dir="$backup_root/$id"
    if [ -e "$dir" ]; then
        fail "$dir already exists"
    fi
    mkdir "$dir"

    note "the pair $id: the database and $state_dir"
    note "the two halves belong to one point in time - stop the control plane for the dump, or at the very least hold the rotation of the CA and of the key encryption keys while it runs"

    # --no-owner and --no-privileges: the restore is done by whoever owns
    # the empty database it goes into, which on a rebuilt installation is
    pg_dump --format=custom --no-owner --no-privileges \
        --dbname "$CONNECTION" --file "$dir/database.dump"
    # --numeric-owner: the names of the accounts of this image say nothing
    # about the host the archive goes back onto; 65532 is what matters and
    tar --numeric-owner --zstd --create --file "$dir/state.tar.zst" \
        --directory "$state_dir" .

    ( cd "$dir" && sha256sum database.dump state.tar.zst > SHA256SUMS )
    local database_sha state_sha
    database_sha="$(awk '$2 == "database.dump" { print $1 }' "$dir/SHA256SUMS")"
    state_sha="$(awk '$2 == "state.tar.zst" { print $1 }' "$dir/SHA256SUMS")"

    # The identity of the installation, read from the database it was just
    # taken from. It is what tells two backups of two installations apart
    local installation_id active_key_id issuer_id
    installation_id="$(query 'select installation_id from crypto_installation_state' 2>/dev/null || true)"
    active_key_id="$(query 'select active_secrets_key_id from crypto_installation_state' 2>/dev/null || true)"
    issuer_id="$(query 'select active_agent_ca_id from crypto_installation_state' 2>/dev/null || true)"

    # The digest of the image is not something a container can read about
    # itself: it comes from the deployment that pinned it. An installation
    if [ -z "${FLOTESTRO_IMAGE_DIGEST:-}" ]; then
        note "the deployment does not pin this image by digest, so the manifest records none"
    fi

    jq -n \
        --arg backup_id "$id" \
        --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg version "${FLOTESTRO_IMAGE_VERSION:-}" \
        --arg commit "${FLOTESTRO_IMAGE_COMMIT:-}" \
        --arg installation_id "$installation_id" \
        --arg active_key_id "$active_key_id" \
        --arg issuer_id "$issuer_id" \
        --arg database_archive "database.dump" \
        --arg database_sha256 "$database_sha" \
        --arg state_archive "state.tar.zst" \
        --arg state_sha256 "$state_sha" \
        --arg image_digest "${FLOTESTRO_IMAGE_DIGEST:-}" \
        'def orNull: if . == "" then null else . end;
         {backup_id: $backup_id,
          created_at: $created_at,
          flotestro_version: ($version | orNull),
          commit: ($commit | orNull),
          installation_id: ($installation_id | orNull),
          active_key_id: ($active_key_id | orNull),
          issuer_id: ($issuer_id | orNull),
          database_method: "pg_dump-custom",
          database_archive: $database_archive,
          database_sha256: $database_sha256,
          state_archive: $state_archive,
          state_sha256: $state_sha256,
          image_digest: ($image_digest | orNull)}' \
        > "$dir/manifest.json"

    note "written to $dir: database.dump, state.tar.zst, manifest.json, SHA256SUMS"
    note "the manifest carries no DSN, no password and no secret - the backup itself does, so it belongs on encrypted storage away from this host"
    note "put it back with: restore $id"
}

restore() {
    local dir
    dir="$(resolve "${1:-}")"
    checksums "$dir"
    connect

    if [ ! -w "$state_dir" ]; then
        fail "$state_dir is read only; the restore is run from the restore profile, which mounts the state read-write, and not from the backup one"
    fi
    if [ -n "$(ls -A "$state_dir")" ]; then
        fail "$state_dir is not empty; a restore never writes over the identity of an installation that is still there - empty the volume deliberately first"
    fi
    local tables
    tables="$(query "select count(*) from information_schema.tables where table_schema = 'public'")"
    if [ "$tables" != "0" ]; then
        fail "the target database already holds $tables tables in the public schema; a restore goes into an empty database"
    fi

    # -p keeps the modes of the archive - the state is 0700 and the keys in
    # it are 0600, and a restore that widened them would be a restore that
    tar --numeric-owner --zstd --extract --preserve-permissions \
        --file "$dir/state.tar.zst" --directory "$state_dir"
    pg_restore --no-owner --no-privileges --exit-on-error \
        --dbname "$CONNECTION" "$dir/database.dump"

    note "the pair $(basename "$dir") is back: the state in $state_dir and the schema in the database"
    note "next: start one control plane - it runs the migrator itself - and check that the installation identifier, the CA and the agents are the ones the manifest names"
}

verify() {
    local dir
    dir="$(resolve "${1:-}")"
    checksums "$dir"
    note "the files of $dir are the ones that were written"
    jq . "$dir/manifest.json"
}

usage() {
    cat <<'USAGE'
flotestro-admin-tools <command>

  backup              take the database and the state directory as one pair
  restore <id>        put that pair back into an empty database and an empty state
  verify <id>         check the checksums and show the manifest
  auditverify <file>  check an export of the audit trail
  version             the version of this image

Anything else is run as it stands, so psql, pg_dump and pg_restore are
available by hand:

  docker compose --profile tools run --rm admin-tools psql --version
USAGE
}

subcommand="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi
case "$subcommand" in
    backup) backup "$@" ;;
    restore) restore "${1:-}" ;;
    verify) verify "${1:-}" ;;
    # The binary carries the full name in the image, as it does in the
    # packages; the short word is what a runbook writes.
    auditverify) exec flotestro-auditverify "$@" ;;
    version)
        printf 'flotestro-admin-tools %s (%s, %s)\n' \
            "${FLOTESTRO_IMAGE_VERSION:-unknown}" \
            "${FLOTESTRO_IMAGE_COMMIT:-unknown}" \
            "${FLOTESTRO_IMAGE_CREATED:-unknown}"
        flotestro-auditverify version
        pg_dump --version
        ;;
    help|-h|--help) usage ;;
    *) exec "$subcommand" "$@" ;;
esac
TOOL

# The version is written in as an environment variable as well as a label,
# because the manifest of a backup names the release it was taken from and
ENV FLOTESTRO_IMAGE_VERSION="${VERSION}" \
    FLOTESTRO_IMAGE_COMMIT="${COMMIT}" \
    FLOTESTRO_IMAGE_CREATED="${BUILD_DATE}" \
    FLOTESTRO_BACKUP_DIR=/backups \
    FLOTESTRO_STATE_DIR=/state \
    HOME=/tmp

USER 65532:65532
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/flotestro-admin-tools"]
CMD ["help"]

# The package repository of the air-gapped profile: one static tree, served
# to the hosts of an isolated site over HTTP.
FROM go-build AS repository-build
ARG TARGETOS TARGETARCH
WORKDIR /repository-server

# The server is a module of its own, outside the product: it ships in no
# package, has no import of ours and is deployment furniture, not a binary
COPY <<'SERVER' main.go
// Command repository-server serves one already-signed repository tree over
// HTTP, read only: it verifies nothing and decides nothing.
package main

import (
	"context"
	"errors"
	"flag"
	"io/fs"
	"log"
	"net/http"
	"os"
	"os/signal"
	"path/filepath"
	"syscall"
	"time"
)

// keyFile is the public key of the repository. The hosts fetch it from here
// before they install anything, so a tree without it is not servable.
const keyFile = "flotestro-repo.asc"

func main() {
	address := flag.String("addr", env("FLOTESTRO_REPOSITORY_ADDR", "0.0.0.0:8080"),
		"the address to listen on")
	root := flag.String("root", env("FLOTESTRO_REPOSITORY_ROOT", "/srv/repository"),
		"the directory with the signed repository tree")
	flag.Parse()

	// Fail closed at start instead of answering 404 to every host: an empty
	// mount over the tree is the one mistake this service can make.
	if _, err := os.Stat(filepath.Join(*root, keyFile)); err != nil {
		log.Fatalf("%s carries no %s, so it is not a signed repository tree: %v", *root, keyFile, err)
	}

	mux := http.NewServeMux()
	mux.HandleFunc("/healthz", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "text/plain; charset=utf-8")
		_, _ = w.Write([]byte("ok\n"))
	})
	mux.Handle("/", http.FileServer(tree{http.Dir(*root)}))

	server := &http.Server{
		Addr:              *address,
		Handler:           readOnly(mux),
		ReadHeaderTimeout: 10 * time.Second,
		IdleTimeout:       60 * time.Second,
	}
	// No write deadline: a package is a large file over a slow site link,
	// and a deadline here would cut the download rather than protect anything.

	go func() {
		stop := make(chan os.Signal, 1)
		signal.Notify(stop, syscall.SIGTERM, os.Interrupt)
		<-stop
		ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
		defer cancel()
		_ = server.Shutdown(ctx)
	}()

	log.Printf("the repository in %s is served on %s", *root, *address)
	if err := server.ListenAndServe(); !errors.Is(err, http.ErrServerClosed) {
		log.Fatal(err)
	}
}

// readOnly answers anything that is not a read itself: this service holds no
// state a request could change.
func readOnly(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet && r.Method != http.MethodHead {
			w.Header().Set("Allow", "GET, HEAD")
			http.Error(w, "the repository answers GET and HEAD", http.StatusMethodNotAllowed)
			return
		}
		next.ServeHTTP(w, r)
	})
}

// tree is the repository without directory listings: a package manager asks
// for files by name, and an index is one more thing to get wrong.
type tree struct{ dir http.FileSystem }

func (t tree) Open(name string) (http.File, error) {
	file, err := t.dir.Open(name)
	if err != nil {
		return nil, err
	}
	info, err := file.Stat()
	if err != nil {
		_ = file.Close()
		return nil, err
	}
	if info.IsDir() {
		_ = file.Close()
		return nil, fs.ErrNotExist
	}
	return file, nil
}

func env(name, fallback string) string {
	if value := os.Getenv(name); value != "" {
		return value
	}
	return fallback
}
SERVER

RUN --mount=type=cache,id=flotestro-gobuild,target=/root/.cache/go-build \
    go mod init flotestro-repository-server >/dev/null && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -ldflags="-s -w" \
      -o /out/flotestro-repository-server .

# The tree is normalised here and not in the final image, which has no shell
# to do it with: the modes it arrives with are those of whoever signed it.
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS repository-tree
COPY --from=repository . /srv/repository/
RUN if [ ! -f /srv/repository/flotestro-repo.asc ]; then \
        echo "the build context 'repository' carries no flotestro-repo.asc; compose the tree with packaging/sign-repo.sh first" >&2; \
        exit 1; \
    fi && \
    find /srv/repository -type d -exec chmod 0755 {} + && \
    find /srv/repository -type f -exec chmod 0444 {} +

# The same distroless base as the two other services: a repository is a
# binary and a directory of files, and everything else in an image that the
FROM --platform=$TARGETPLATFORM ${RUNTIME_IMAGE} AS package-repository

ARG VERSION COMMIT BUILD_DATE
LABEL org.opencontainers.image.title="Flotestro package repository" \
      org.opencontainers.image.source="https://github.com/ultherego/Flotestro" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

COPY --from=repository-build /out/flotestro-repository-server /usr/local/bin/
COPY --from=go-build /out/flotestro-healthcheck /usr/local/bin/
# Read-only for the account that serves it: the process never writes into the
# tree, and a repository a request could change is a way into the fleet.
COPY --from=repository-tree /srv/repository/ /srv/repository/

ENV FLOTESTRO_REPOSITORY_ROOT=/srv/repository \
    FLOTESTRO_REPOSITORY_ADDR=0.0.0.0:8080

USER 65532:65532
EXPOSE 8080
STOPSIGNAL SIGTERM
# The server answers /healthz itself, so the health client of the other
# images asks the same question here.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/flotestro-healthcheck", "-addr", "127.0.0.1:8080"]
ENTRYPOINT ["/usr/local/bin/flotestro-repository-server"]
