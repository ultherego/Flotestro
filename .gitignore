# Go
/bin/
/dist/
*.test
*.out
# Binaries built in the repository root by "go build" without -o.
/flotestro-*
/agent
/agent-helper
/agent-simulator
/control-plane
/relay

# Node / Web UI
# No trailing slash: a pattern that ends in one matches a directory alone, and
# a worktree's web/node_modules is a symbolic link to another checkout's copy.
# The rule read right and ignored it; the link reached a commit.
node_modules
/web/dist/

# local configuration
.env
.env.*
*.local

# Dependencies and the build output of the panel
web/node_modules
web/dist/
# The incremental build record of tsc: a local cache, not a source.
web/tsconfig.tsbuildinfo
